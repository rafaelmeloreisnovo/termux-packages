{
  "schema": "rafaelia.knowledge-work-seven-guards.v1",
  "semantic_version": "1.1.0",
  "repository": "rafaelmeloreisnovo/termux-packages",
  "role": "PACKAGE_SOURCE_FACTORY",
  "federated_authority": "rafaelmeloreisnovo/Mapa",
  "source_contract": {
    "repository": "rafaelmeloreisnovo/Mapa",
