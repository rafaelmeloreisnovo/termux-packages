    "path": "docs/canonical/2026-09-13/CASA_CONHECIMENTO_TRABALHO_V1.md"
  },
  "required_guards": [
    "provenance",
    "context",
    "evidence",
    "contradiction",
    "uncertainty",
    "reproduction",
    "rollback"
  ],
  "allowed_states": {
    "contradiction": ["OPEN","RESOLVED","SUPERSEDED"],
    "uncertainty": ["TOKEN_VAZIO","BLOCKED","PARTIAL","NOT_APPLICABLE","CLOSED"],
    "reproduction": ["TOKEN_VAZIO","BLOCKED","PASS","FAIL","NOT_APPLICABLE"],
    "rollback": ["TOKEN_VAZIO","BLOCKED","READY","EXECUTED","NOT_APPLICABLE"]
  },
  "allowed_evidence_types": [
    "TEST","RUN","HASH","DATA","RECEIPT","REVIEW","NEGATIVE_RESULT","TEST_FIXTURE","CI","ARTIFACT"
  ],
  "reproduction_evidence_types": ["TEST","RUN","RECEIPT","TEST_FIXTURE","CI"],
  "reconstructibility_transverse": true,
  "reconstruction_pointer_required": true,
  "claim_allowed": false,
  "promotion_target": "READY_FOR_DOMAIN_REVIEW",
  "repository_boundaries": [
    "SOURCE!=RECIPE!=ARTIFACT!=INSTALL!=RUNTIME",
    "SOURCE!=ARTIFACT!=EXECUTION!=EVIDENCE!=CLAIM",
    "TOKEN_VAZIO!=0",
    "BUILD_SUCCESS!=INSTALL_SUCCESS",
    "INSTALL_SUCCESS!=RUNTIME_SUCCESS",
    "PACKAGE_PRODUCER!=RUNTIME_CONSUMER",
    "STRUCTURAL_READY!=DOMAIN_CLAIM"
  ],
  "consumer_repository": "rafaelmeloreisnovo/termux-app-rafacodephi",
  "rollback_rule": "material_mutation_requires_READY_or_EXECUTED",
  "unknown_rule": "UNKNOWN_OR_UNRECOGNIZED_STATE_BLOCKS_PROMOTION",
  "license_rule": "no_single_license_flattening"
}
