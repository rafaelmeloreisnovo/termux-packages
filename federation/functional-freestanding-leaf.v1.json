  ],
  "verification_commands": [
    "python3 scripts/validate_rafcodephi_freestanding_module.py",
    "python3 scripts/validate_rafcodephi_federated_provenance.py"
  ],
  "freestanding_evidence": "docs/assurance/rafcodephi-freestanding-modules.v1.json",
